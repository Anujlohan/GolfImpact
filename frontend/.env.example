# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# IMPORTANT:
# - Only variables prefixed with NEXT_PUBLIC_ will be exposed to the browser.
# - DO NOT place backend secrets, private API keys, or service role keys here.
# - Copy this file to `frontend/.env` (or `frontend/.env.local`) for local dev.
# ==============================================================================

# Application Base URL (used for redirects, navigation, and API calls)
# Example for local development: http://localhost:3000
# Example for production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration (Client-side / Browser-safe)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Publishable / Anonymous Key (Supabase Dashboard -> Project Settings -> API)
# Safe to expose in the browser; governed by Supabase Row-Level Security (RLS) policies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# ------------------------------------------------------------------------------
# Stripe Configuration (Client-side / Browser-safe)
# ------------------------------------------------------------------------------
# Your Stripe Publishable Key (found in Stripe Dashboard -> Developers -> API keys)
# Format: pk_test_... (for development) or pk_live_... (for production)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
