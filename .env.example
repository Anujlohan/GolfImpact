# ==============================================================================
# DIGITAL HEROES / GOLF IMPACT — UNIFIED ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# This root file documents all environment variables used across the project.
#
# FOR PROPER FULL-STACK SECURITY:
# - Frontend-only (browser-safe) variables belong in `frontend/.env`
# - Backend secrets (server-only) belong in `backend/.env`
#
# NEVER COMMIT ACTUAL `.env` FILES TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Configuration (Shared / Public)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# 2. Supabase Configuration
# ------------------------------------------------------------------------------
# [Frontend & Backend] Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# [Frontend & Backend] Supabase Publishable / Anonymous Key (Safe for browser with RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# [Backend Only - SECRET] Supabase Secret / Service Role Key (Bypasses RLS for admin operations)
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key

# [Backend Only - Database] Direct PostgreSQL Connection URI (for migrations & seeds)
DATABASE_URL=postgresql://postgres:your-database-password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. Stripe Configuration
# ------------------------------------------------------------------------------
# [Frontend & Backend] Stripe Publishable Key (Safe for browser checkout redirection)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# [Backend Only - SECRET] Stripe Secret API Key (Full API access)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# [Backend Only - SECRET] Stripe Webhook Signing Secret (Verifies webhook payloads)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# [Backend Only] Stripe Recurring Subscription Price IDs
STRIPE_PRICE_ID_MONTHLY=price_monthly_id_placeholder
STRIPE_PRICE_ID_YEARLY=price_yearly_id_placeholder
