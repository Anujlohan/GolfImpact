# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# IMPORTANT:
# - These variables and secrets are SERVER-ONLY and must NEVER be committed to Git
#   or exposed to the browser.
# - Copy this file to `backend/.env` (or `backend/.env.local`) for local dev.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3000

# Application Base URL (used for constructing redirect/callback URLs, origins)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Database & Admin Configuration
# ------------------------------------------------------------------------------
# Supabase Project URL (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable / Anonymous Key (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Supabase Secret / Service Role Key (Supabase Dashboard -> Project Settings -> API)
# SENSITIVE: Has administrative privileges and bypasses Row Level Security (RLS).
# Used by backend services, cron jobs, webhook handlers, and admin tasks.
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key

# Direct PostgreSQL Connection URI (Supabase Dashboard -> Project Settings -> Database)
# Used for schema migrations (backend/supabase/migrations) and seed data scripts.
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-database-password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Stripe Server & Webhook Configuration
# ------------------------------------------------------------------------------
# Stripe Secret Key (Stripe Dashboard -> Developers -> API keys)
# SENSITIVE: Gives full access to your Stripe account. Never share or expose.
# Format: sk_test_... (for development) or sk_live_... (for production)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe Webhook Signing Secret (Stripe Dashboard -> Developers -> Webhooks)
# SENSITIVE: Used by /api/stripe/webhook to verify event signatures and prevent spoofing.
# Format: whsec_...
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Stripe Price IDs for Subscription Plans
# (Stripe Dashboard -> Product catalog -> Select product -> Copy Price ID)
STRIPE_PRICE_ID_MONTHLY=price_monthly_id_placeholder
STRIPE_PRICE_ID_YEARLY=price_yearly_id_placeholder
